# ============================================================
# 9. DEFINE LEAKAGE COLUMNS
# ============================================================

# These are outcomes or variables that are only known
# after/around harvest.
#
# They MUST NOT be predictors.

leakage_columns = [

    # Direct target
    "Yield",
    "YIELDMT",

    # Production
    "Production_Kg",
    "ProductionMT",

    # Harvest outcomes
    "AREA_HARVESTED",
    "TCP_AREA_HARVESTED_HA",

    # Harvest quantity
    "TCP09_QTY",

    # Harvest-related survey variables
    "TCP06",
    "TCP07",

    # Harvest timing
    "TCP08__10",
    "TCP08__11",
    "TCP08__12",
    "TCP08__1",
    "TCP08__2",
    "TCP08__3",
    "TCP08__4",
    "TCP08__5",
    "TCP08__6",
    "TCP08__7",
    "TCP08__8",
    "TCP08__9",

    # Harvest-area questionnaire fields
    "TCP10a",
    "TCP10_UNIT",
    "TCP10b",
    "TCP11",

    # Post-harvest / retention
    "SEEDRETENTION",
    "SEEDRETENTION_MT",
    "TOTALSEEDREQUIRED_MT",
    "QUANTITYSEEDOWNHARV",

    # Replant quantity is management-related but can
    # be retained because it occurred before harvest.
    # Therefore do NOT remove REPLANTED_KG/MT here.

]


# ============================================================
# 10. REMOVE IDENTIFIERS
# ============================================================

identifier_columns = [

    "agrisense_id",

    "interview__key",
    "interview__id",

    "LAND",
    "FIELD",

    "HHN",
    "HHID_LIST",

    "CLUSTER",
    "EA",

    "WEIGHT3",

]


# ============================================================
# 11. REMOVE RAW COORDINATES
# ============================================================

coordinate_columns = [

    "latitude",
    "longitude",

    "lat_key",
    "lon_key",

    "has_coordinates",

]


# ============================================================
# 12. REMOVE ADMINISTRATIVE LOCATION
# ============================================================

# We use district as the GROUP for spatial validation,
# but don't give the model district itself as a predictor.
#
# Otherwise the model could simply memorize location.

location_columns = [

    "province",
    "district",
    "ward",

    "district_key",
    "ward_key",

    "location_match_method",

]


# ============================================================
# 13. BUILD DROP LIST
# ============================================================

drop_columns = set()

drop_columns.update(
    leakage_columns
)

drop_columns.update(
    identifier_columns
)

drop_columns.update(
    coordinate_columns
)

drop_columns.update(
    location_columns
)


# ============================================================
# 14. REMOVE OTHER OBVIOUS POST-HARVEST FIELDS
# ============================================================

for column in df.columns:

    upper = column.upper()

    # Direct production/yield fields
    if (
        "PRODUCTION" in upper
        or upper == "YIELD"
        or "YIELDMT" in upper
    ):

        drop_columns.add(column)


# ============================================================
# 15. BUILD X / y
# ============================================================

feature_columns = [
    column
    for column in df.columns
    if column not in drop_columns
]


X = df[
    feature_columns
].copy()

y = df[
    TARGET
].copy()


# ============================================================
# 16. REMOVE COMPLETELY EMPTY FEATURES
# ============================================================

empty_features = [
    column
    for column in X.columns
    if X[column].isna().all()
]

if empty_features:

    print(
        "\nRemoving completely empty features:"
    )

    for column in empty_features:
        print(
            "  ",
            column
        )

    X = X.drop(
        columns=empty_features
    )


# ============================================================
# 17. REMOVE CONSTANT FEATURES
# ============================================================

constant_features = [
    column
    for column in X.columns
    if X[column].nunique(
        dropna=True
    ) <= 1
]

if constant_features:

    print(
        "\nRemoving constant features:",
        len(constant_features)
    )

    X = X.drop(
        columns=constant_features
    )


# ============================================================
# 18. DATA TYPES
# ============================================================

categorical_features = (
    X.select_dtypes(
        include=[
            "object",
            "category"
        ]
    )
    .columns
    .tolist()
)

numeric_features = [
    column
    for column in X.columns
    if column not in categorical_features
]


print(
    "\nFeature count:",
    len(X.columns)
)

print(
    "Numeric features:",
    len(numeric_features)
)

print(
    "Categorical features:",
    len(categorical_features)
)


# ============================================================
# 19. PREPROCESSOR
# ============================================================

numeric_pipeline = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(
                strategy="median"
            )
        )
    ]
)


categorical_pipeline = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(
                strategy="most_frequent"
            )
        ),
        (
            "encoder",
            OneHotEncoder(
                handle_unknown="ignore"
            )
        )
    ]
)


preprocessor = ColumnTransformer(
    transformers=[

        (
            "numeric",
            numeric_pipeline,
            numeric_features
        ),

        (
            "categorical",
            categorical_pipeline,
            categorical_features
        )

    ],
    remainder="drop"
)


# ============================================================
# 20. SPATIAL GROUP
# ============================================================

if "district" in df.columns:

    groups = (
        df["district"]
        .fillna("UNKNOWN")
        .astype(str)
    )

elif "province" in df.columns:

    groups = (
        df["province"]
        .fillna("UNKNOWN")
        .astype(str)
    )

else:

    raise ValueError(
        "No geographic grouping column available."
    )


number_of_groups = (
    groups.nunique()
)

print(
    "\nSpatial groups:",
    number_of_groups
)

if number_of_groups < 3:

    raise ValueError(
        "At least 3 geographic groups "
        "are required."
    )


number_of_splits = min(
    5,
    number_of_groups
)


ExtraTreesRegressor(
        n_estimators=400,
        min_samples_leaf=2,
        random_state=RANDOM_STATE,
        n_jobs=-1
    )



