import os
import json
import warnings
import joblib

import numpy as np
import pandas as pd

from sklearn.model_selection import GroupKFold
from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.preprocessing import OneHotEncoder
from sklearn.impute import SimpleImputer

from sklearn.metrics import (
    mean_absolute_error,
    mean_squared_error,
    r2_score
)

from sklearn.ensemble import (
    ExtraTreesRegressor,
    RandomForestRegressor,
    HistGradientBoostingRegressor
)

warnings.filterwarnings("ignore")


# ============================================================
# AGRISENSE — YIELD MODEL TRAINING
# ============================================================

MASTER_FILE = "data/agrisense_master.csv"

MODEL_DIR = "models/agrisense"

os.makedirs(
    MODEL_DIR,
    exist_ok=True
)

RANDOM_STATE = 42


print("=" * 75)
print("AGRISENSE — YIELD MODEL TRAINING")
print("=" * 75)


# ============================================================
# 1. LOAD MASTER DATASET
# ============================================================

df = pd.read_csv(
    MASTER_FILE,
    low_memory=False
)

print(
    "\nMaster dataset:",
    df.shape
)


# ============================================================
# 2. CROP CHECK
# ============================================================

if "crop" in df.columns:

    print("\nCrops:")
    print(
        df["crop"].value_counts()
    )


# ============================================================
# 3. TARGET
# ============================================================

TARGET = "Yield"

if TARGET not in df.columns:

    raise ValueError(
        "Yield target was not found in "
        "agrisense_master.csv"
    )


# ------------------------------------------------------------
# Production fields already present in the CFS
# ------------------------------------------------------------

production_columns = [
    "Production_Kg",
    "ProductionMT",
    "Yield",
    "YIELDMT"
]

print("\nTarget/outcome columns detected:")

for column in production_columns:

    if column in df.columns:

        print(
            f"  {column:<20}",
            "present"
        )


# ============================================================
# 4. NUMERIC TARGET
# ============================================================

df[TARGET] = pd.to_numeric(
    df[TARGET],
    errors="coerce"
)


# ============================================================
# 5. VERIFY CFS YIELD CALCULATION
# ============================================================

if (
    "ProductionMT" in df.columns
    and
    "AREA_HARVESTED" in df.columns
):

    production_mt = pd.to_numeric(
        df["ProductionMT"],
        errors="coerce"
    )

    harvested_area = pd.to_numeric(
        df["AREA_HARVESTED"],
        errors="coerce"
    )

    calculated_yield = np.where(
        harvested_area > 0,
        production_mt / harvested_area,
        np.nan
    )

    comparison = pd.DataFrame({
        "cfs_yield": df[TARGET],
        "calculated_yield": calculated_yield
    })

    comparison["difference"] = (
        comparison["cfs_yield"]
        -
        comparison["calculated_yield"]
    )

    valid_comparison = comparison.dropna()

    if len(valid_comparison) > 0:

        max_difference = (
            valid_comparison["difference"]
            .abs()
            .max()
        )

        mean_difference = (
            valid_comparison["difference"]
            .abs()
            .mean()
        )

        print(
            "\nYield verification:"
        )

        print(
            "Valid comparisons:",
            f"{len(valid_comparison):,}"
        )

        print(
            "Mean absolute difference:",
            f"{mean_difference:.8f}"
        )

        print(
            "Maximum absolute difference:",
            f"{max_difference:.8f}"
        )


# ============================================================
# 6. REMOVE INVALID TARGETS
# ============================================================

df = df[
    df[TARGET].notna()
].copy()

df = df[
    df[TARGET] >= 0
].copy()


print(
    "\nRows with valid yield:",
    f"{len(df):,}"
)


# ============================================================
# 7. TARGET SUMMARY
# ============================================================

print("\nYield summary:")

print(
    df[TARGET].describe()
)


# ============================================================
# 8. SAVE TRAINING-READY DATA
# ============================================================

#training_ready_file = (
#    "data/agrisense_training_ready.csv"
#)

#df.to_csv(
#    training_ready_file,
