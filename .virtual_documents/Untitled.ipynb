# train_one_model.py

import os
import time
import joblib
import numpy as np
import pandas as pd

from sklearn.compose import ColumnTransformer
from sklearn.pipeline import Pipeline
from sklearn.impute import SimpleImputer
from sklearn.preprocessing import OneHotEncoder
from sklearn.ensemble import ExtraTreesRegressor


# ============================================================
# CONFIG
# ============================================================

DATA_PATH = "data/agrisense_training_ready.csv"
MODEL_DIR = "models/agrisense"

TARGET = "Yield"

os.makedirs(MODEL_DIR, exist_ok=True)


# ============================================================
# LOAD DATA
# ============================================================

print("=" * 75)
print("AGRISENSE — SINGLE MODEL TRAINING")
print("=" * 75)

print("\nLoading training data...")

df = pd.read_csv(DATA_PATH)

print(f"Dataset: {df.shape}")


# ============================================================
# TARGET
# ============================================================

if TARGET not in df.columns:
    raise ValueError(
        f"Target '{TARGET}' not found in dataset."
    )

df[TARGET] = pd.to_numeric(
    df[TARGET],
    errors="coerce"
)

df = df.dropna(
    subset=[TARGET]
)

df = df[
    df[TARGET] >= 0
]

print(f"Rows with valid target: {len(df):,}")

print("\nYield statistics:")
print(df[TARGET].describe())


# ============================================================
# REMOVE LEAKAGE
# ============================================================

print("\nRemoving target/leakage columns...")

leakage_columns = []

for col in df.columns:

    name = col.upper()

    # Target itself
    if col == TARGET:
        leakage_columns.append(col)
        continue

    # Production/yield outcome variables
    if "PRODUCTION" in name:
        leakage_columns.append(col)
        continue

    if name in [
        "YIELDMT",
        "AREA_HARVESTED",
        "TCP_AREA_HARVESTED_HA",
        "TCP09_QTY",
        "TCP10A",
        "TCP10_UNIT",
        "TCP10B",
        "TCP11",
        "SEEDRETENTION",
        "SEEDRETENTION_MT",
        "TOTALSEEDREQUIRED_MT",
        "QUANTITYSEEDOWNHARV"
    ]:
        leakage_columns.append(col)
        continue

    # Harvest information
    if name.startswith("TCP08__"):
        leakage_columns.append(col)
        continue


# ============================================================
# REMOVE IDENTIFIERS / LOCATION LABELS
# ============================================================

identifier_columns = []

for col in df.columns:

    name = col.upper()

    if name in [
        "ID",
        "HOUSEHOLD_ID",
        "HHID",
        "RESPONDENT_ID",
        "INTERVIEW_ID"
    ]:
        identifier_columns.append(col)

    # Do not feed administrative location names directly
    if name in [
        "PROVINCE",
        "DISTRICT",
        "WARD"
    ]:
        identifier_columns.append(col)

    # Raw coordinates can cause location memorisation
    if name in [
        "LATITUDE",
        "LONGITUDE"
    ]:
        identifier_columns.append(col)


drop_columns = list(
    dict.fromkeys(
        leakage_columns + identifier_columns
    )
)

print(f"Removing {len(drop_columns)} columns.")


# ============================================================
# CREATE X / y
# ============================================================

X = df.drop(
    columns=drop_columns,
    errors="ignore"
)

y = df[TARGET]


# ============================================================
# REMOVE EMPTY FEATURES
# ============================================================

empty_columns = [
    col
    for col in X.columns
    if X[col].isna().all()
]

if empty_columns:

    print("\nRemoving completely empty features:")

    for col in empty_columns:
        print("  ", col)

    X = X.drop(
        columns=empty_columns
    )


# ============================================================
# REMOVE CONSTANT FEATURES
# ============================================================

constant_columns = [
    col
    for col in X.columns
    if X[col].nunique(dropna=False) <= 1
]

if constant_columns:

    print(
        f"\nRemoving constant features: "
        f"{len(constant_columns)}"
    )

    X = X.drop(
        columns=constant_columns
    )


# ============================================================
# FEATURE TYPES
# ============================================================

numeric_features = X.select_dtypes(
    include=["number"]
).columns.tolist()

categorical_features = X.select_dtypes(
    exclude=["number"]
).columns.tolist()


print("\nFinal training data:")
print(f"Rows:              {len(X):,}")
print(f"Features:          {X.shape[1]:,}")
print(f"Numeric features:  {len(numeric_features)}")
print(f"Categorical:       {len(categorical_features)}")


# ============================================================
# PREPROCESSING
# ============================================================

print("\nBuilding preprocessing pipeline...")

numeric_pipeline = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(
                strategy="median"
            )
        )
    ]
)


categorical_pipeline = Pipeline(
    steps=[
        (
            "imputer",
            SimpleImputer(
                strategy="most_frequent"
            )
        ),
        (
            "onehot",
            OneHotEncoder(
                handle_unknown="ignore",
                sparse_output=True
            )
        )
    ]
)


preprocessor = ColumnTransformer(
    transformers=[
        (
            "numeric",
            numeric_pipeline,
            numeric_features
        ),
        (
            "categorical",
            categorical_pipeline,
            categorical_features
        )
    ]
)


# ============================================================
# ONE MODEL
# ============================================================

print("\nCreating ExtraTreesRegressor...")

model = ExtraTreesRegressor(
    n_estimators=200,
    max_depth=None,
    min_samples_leaf=2,
    max_features=0.7,
    random_state=42,
    n_jobs=-1
)


pipeline = Pipeline(
    steps=[
        (
            "preprocessor",
            preprocessor
        ),
        (
            "model",
            model
        )
    ]
)


# ============================================================
# TRAIN
# ============================================================

print("\n" + "=" * 75)
print("TRAINING")
print("=" * 75)

print("\nModel:")
print("  ExtraTreesRegressor")
print("  Trees: 200")
print("  max_features: 0.7")
print("  min_samples_leaf: 2")
print("  CPU workers: all available")

print("\nStarting training...\n")

start = time.time()

pipeline.fit(
    X,
    y
)

elapsed = time.time() - start


# ============================================================
# SAVE
# ============================================================

model_path = os.path.join(
    MODEL_DIR,
    "agrisense_yield_extratrees.joblib"
)

joblib.dump(
    pipeline,
    model_path
)


# ============================================================
# SAVE FEATURE INFORMATION
# ============================================================

metadata = {
    "target": TARGET,
    "rows": int(len(X)),
    "features": int(X.shape[1]),
    "numeric_features": int(len(numeric_features)),
    "categorical_features": int(len(categorical_features)),
    "model": "ExtraTreesRegressor",
    "n_estimators": 200,
    "max_depth": None,
    "min_samples_leaf": 2,
    "max_features": 0.7,
    "training_seconds": elapsed
}

metadata_path = os.path.join(
    MODEL_DIR,
    "extratrees_metadata.json"
)

import json

with open(
    metadata_path,
    "w"
) as f:

    json.dump(
        metadata,
        f,
        indent=2
    )


# ============================================================
# DONE
# ============================================================

print("\n" + "=" * 75)
print("TRAINING COMPLETE")
print("=" * 75)

print(f"\nTraining time: {elapsed / 60:.2f} minutes")

print(f"\nModel saved to:")
print(model_path)

print(f"\nMetadata saved to:")
print(metadata_path)

print("\nAgriSense yield model is ready.")
print("=" * 75)

